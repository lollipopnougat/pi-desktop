{
  "name": "pi-desktop",
  "version": "0.3.7",
  "description": "Pi Desktop App - AI coding assistant powered by pi agent SDK",
  "license": "MIT",
  "main": "dist-electron/main.js",
  "type": "commonjs",
  "author": "lollipopnougat",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "icons": "node scripts/generate-icons.mjs",
    "notices": "node scripts/generate-third-party-notices.mjs",
    "ask-name": "node scripts/ask-name.js",
    "postinstall": "node scripts/fix-pty-perm.js && node scripts/patch-pi-loader.js",
    "start": "vite",
    "electron:dev": "vite",
    "electron:build": "npm run icons && npm run notices && npm run build && electron-builder",
    "electron:build:win": "npm run icons && npm run notices && npm run build && electron-builder --win portable --x64",
    "electron:build:win:dir": "npm run icons && npm run notices && npm run build && electron-builder --win dir --x64",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"electron/**/*.ts\" \"preload.ts\" \"*.{ts,js,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"electron/**/*.ts\" \"preload.ts\""
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^1.1.0",
    "@earendil-works/pi-coding-agent": "^1.0.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "monaco-editor": "^0.52.0",
    "monaco-themes": "^0.4.8",
    "node-pty": "^1.1.0",
    "typebox": "^1.3.10",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@internationalized/date": "^3.12.4",
    "@monaco-editor/react": "^4.6.0",
    "@tailwindcss/typography": "^0.5.20",
    "@types/diff": "^5.2.3",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^24.19.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.10",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "diff": "^5.2.0",
    "dompurify": "^3.4.12",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "highlight.js": "^11.11.1",
    "marked": "^18.0.7",
    "postcss": "^8.4.49",
    "prettier": "^3.9.6",
    "react": "^18.3.1",
    "react-aria-components": "^1.21.1",
    "react-dom": "^18.3.1",
    "svg2img": "^1.0.0-beta.2",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.0.1",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^4.1.10",
    "wait-on": "^8.0.1",
    "zustand": "^4.5.5"
  },
  "build": {
    "appId": "com.earendil.pi-desktop",
    "productName": "Pi Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/icons/icon.png",
      "!**/node_modules/**/*.map",
      "!**/node_modules/**/*.d.ts",
      "!**/node_modules/**/*.d.ts.map",
      "!**/node_modules/**/*.ts.map",
      "!**/node_modules/**/{src,docs,doc,examples,example,tests,test,__tests__,__test__,coverage,benchmark,benchmarks,fixtures,mock,mocks,man}/**",
      "!**/node_modules/**/*.{md,markdown,MD,ts,tsx,coffee,flow,mdx}",
      "!**/node_modules/**/{CHANGELOG,CHANGES,HISTORY,NOTICE,README,readme}*",
      "!**/node_modules/**/{.github,.vscode,.idea,.nyc_output,.git,.cache}/**",
      "!**/node_modules/**/{*.tgz,*.tar.gz,*.zip}",
      "!**/node_modules/monaco-editor/{dev,min-maps,esm}/**",
      "!**/node_modules/highlight.js/{styles,scss}/**",
      "!**/node_modules/@mariozechner/clipboard-{linux,win32}*/**",
      "!**/node_modules/@mariozechner/clipboard-darwin-{x64,universal}/**",
      "!**/node_modules/@esbuild/**",
      "!**/node_modules/esbuild/**",
      "!**/node_modules/@earendil-works/chord/dist/node{,/**/*}",
      "!**/node_modules/@earendil-works/pi-coding-agent/dist/bundle{,/**/*}",
      "!**/node_modules/node-pty/**/*.test.js",
      "!**/node_modules/node-pty/scripts{,/**/*}",
      {
        "from": "node_modules/@earendil-works/pi-coding-agent/docs",
        "to": "node_modules/@earendil-works/pi-coding-agent/docs",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "node_modules/@earendil-works/pi-coding-agent/examples",
        "to": "node_modules/@earendil-works/pi-coding-agent/examples",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "node_modules/@earendil-works/pi-coding-agent",
        "to": "node_modules/@earendil-works/pi-coding-agent",
        "filter": [
          "README.md",
          "CHANGELOG.md"
        ]
      }
    ],
    "asarUnpack": [
      "**/node_modules/node-pty/**",
      "**/node_modules/@earendil-works/pi-coding-agent/docs/**",
      "**/node_modules/@earendil-works/pi-coding-agent/examples/**",
      "**/node_modules/@earendil-works/pi-coding-agent/README.md",
      "**/node_modules/@earendil-works/pi-coding-agent/CHANGELOG.md",
      "**/node_modules/@earendil-works/pi-coding-agent/package.json",
      "**/node_modules/@earendil-works/pi-coding-agent/dist/core/export-html/**",
      "**/node_modules/@earendil-works/pi-coding-agent/dist/modes/interactive/theme/**"
    ],
    "extraResources": [
      {
        "from": "resources/skills",
        "to": "skills",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/agents",
        "to": "agents",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/terminal-themes",
        "to": "terminal-themes",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/docs",
        "to": "docs",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/THIRD-PARTY-NOTICES.txt",
        "to": "THIRD-PARTY-NOTICES.txt"
      }
    ],
    "afterPack": "./scripts/fix-pty-perm.js",
    "mac": {
      "identity": null,
      "minimumSystemVersion": "13.0",
      "icon": "build/icons/icon.icns",
      "target": [
        "dmg"
      ],
      "electronLanguages": [
        "zh-CN",
        "en-US"
      ],
      "extendInfo": {
        "CFBundleLocalizations": [
          "zh-CN",
          "en-US"
        ],
        "CFBundleDevelopmentRegion": "zh-CN"
      },
      "files": [
        "!**/node_modules/@mariozechner/clipboard-{linux,win32}*/**",
        "!**/node_modules/@mariozechner/clipboard-darwin-{x64,universal}/**",
        "!**/node_modules/node-pty/prebuilds/win32-*/**",
        "!**/node_modules/node-pty/deps{,/**/*}",
        "!**/node_modules/@earendil-works/pi-tui/native/{linux,win32}/**",
        "!coverage{,/**/*}",
        "!plans{,/**/*}",
        "!.pi{,/**/*}",
        "!.pi-desktop{,/**/*}",
        "!.claude{,/**/*}",
        "!vitest.config.*",
        "!.prettierignore",
        "!src{,/**/*}",
        "!electron{,/**/*}",
        "!scripts{,/**/*}",
        "!tests{,/**/*}",
        "!types{,/**/*}",
        "!docs{,/**/*}",
        "!examples{,/**/*}",
        "!resources{,/**/*}",
        "!{preload,index}.{ts,js,html}",
        "!*.md{,x}",
        "!tsconfig{,.*}.json",
        "!tsconfig.tsbuildinfo",
        "!vite.config.{ts,js}",
        "!eslint.config.*",
        "!postcss.config.*",
        "!tailwind.config.*",
        "!.{editorconfig,gitignore,npmrc,prettierrc,eslintrc}*",
        "!**/*-unpacked{,/**/*}"
      ]
    },
    "win": {
      "icon": "build/icons/icon.ico",
      "target": [
        "nsis"
      ],
      "electronLanguages": [
        "zh-CN",
        "en-US"
      ],
      "files": [
        "!**/node_modules/@mariozechner/clipboard-{linux,darwin}*/**",
        "!**/node_modules/@mariozechner/clipboard-win32-arm64-msvc/**",
        "!**/node_modules/node-pty/prebuilds/darwin-*/**",
        "!**/node_modules/@earendil-works/pi-tui/native/{linux,darwin}/**",
        "!coverage{,/**/*}",
        "!plans{,/**/*}",
        "!.pi{,/**/*}",
        "!.pi-desktop{,/**/*}",
        "!.claude{,/**/*}",
        "!vitest.config.*",
        "!.prettierignore",
        "!src{,/**/*}",
        "!electron{,/**/*}",
        "!scripts{,/**/*}",
        "!tests{,/**/*}",
        "!types{,/**/*}",
        "!docs{,/**/*}",
        "!examples{,/**/*}",
        "!resources{,/**/*}",
        "!{preload,index}.{ts,js,html}",
        "!*.md{,x}",
        "!tsconfig{,.*}.json",
        "!tsconfig.tsbuildinfo",
        "!vite.config.{ts,js}",
        "!eslint.config.*",
        "!postcss.config.*",
        "!tailwind.config.*",
        "!.{editorconfig,gitignore,npmrc,prettierrc,eslintrc}*",
        "!**/*-unpacked{,/**/*}"
      ]
    },
    "linux": {
      "icon": "build/icons/icon.png",
      "target": [
        "AppImage"
      ],
      "electronLanguages": [
        "zh-CN",
        "en-US"
      ],
      "files": [
        "!**/node_modules/@mariozechner/clipboard-{darwin,win32}*/**",
        "!**/node_modules/@mariozechner/clipboard-linux-{arm64,x64,riscv64}-musl/**",
        "!**/node_modules/@mariozechner/clipboard-linux-riscv64-gnu/**",
        "!**/node_modules/node-pty/prebuilds/{darwin,win32}-*/**",
        "!**/node_modules/node-pty/deps{,/**/*}",
        "!**/node_modules/@earendil-works/pi-tui/native/{darwin,win32}/**",
        "!coverage{,/**/*}",
        "!plans{,/**/*}",
        "!.pi{,/**/*}",
        "!.pi-desktop{,/**/*}",
        "!.claude{,/**/*}",
        "!vitest.config.*",
        "!.prettierignore",
        "!src{,/**/*}",
        "!electron{,/**/*}",
        "!scripts{,/**/*}",
        "!tests{,/**/*}",
        "!types{,/**/*}",
        "!docs{,/**/*}",
        "!examples{,/**/*}",
        "!resources{,/**/*}",
        "!{preload,index}.{ts,js,html}",
        "!*.md{,x}",
        "!tsconfig{,.*}.json",
        "!tsconfig.tsbuildinfo",
        "!vite.config.{ts,js}",
        "!eslint.config.*",
        "!postcss.config.*",
        "!tailwind.config.*",
        "!.{editorconfig,gitignore,npmrc,prettierrc,eslintrc}*",
        "!**/*-unpacked{,/**/*}"
      ]
    }
  }
}
